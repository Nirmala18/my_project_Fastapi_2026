@app.post("/post",status_code=status.HTTP_201_CREATED,response_model=schemas.UserOut)#return key value pairs
def Post_usr(user:schemas.Usercreate,db:Session=Depends(get_db)):#schemas class and db class mthod
      #we need to do couple of thing before crating user create the "hash the password"
# hash the password = user.password
      hashed_password = utils.hash(user.password)#schema req,util is class,hash is function
      user.password = hashed_password # set this to new hashpassword
      
      # create a user
      create = models.User(**user.model_dump())# req convert to dictionay
          # Check if email already exists
      existUser = db.query(models.User).filter(models.User.email == user.email).first()
      #existUser.first()# grab the first query
      if existUser:
            raise HTTPException(status.HTTP_400_BAD_REQUEST,detail="email is already exist")
      
      create = models.User(**user.model_dump())# req convert to dictionay
      db.add(create)
      db.commit()
      db.refresh(create)
      return create

