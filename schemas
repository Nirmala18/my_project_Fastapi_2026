from pydantic import BaseModel,EmailStr
from datetime import datetime
      #as per the doc sqlalchmey, response shld also retrun with schema
#create or read post
class PostBase(BaseModel): #create post 
      title:str
      content:str
      published: bool = True     
      
class PostCreate(PostBase):# extend the above class# retrive post
      pass

class Post(PostBase): #update
      id :int
      created_at: datetime
      
      class Config:
            from_attributes = True  # Allows conversion from SQLAlchemy model to Pydantic

#user schema
class Usercreate(BaseModel): #pydantic basemodel
      email:EmailStr
      password : str
      
#user response in postman with keyvalue pairs
class UserOut(BaseModel): # response pydantic 
      id: int
      email: EmailStr
      created_at: datetime
      
      class Config:
            from_attributes = True  # Allows conversion from SQLAlchemy model to Pydantic
class UserLogin(BaseModel):
      email : EmailStr
      password : str
