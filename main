@app.post("/posts",status_code = status.HTTP_201_CREATED)
def create_posts(post:Post):
    cursor.execute("""INSERT INTO posts(title, content, published) VALUES (%s,%s,%s) RETURNING * """,
                   (post.title,post.content,post.published))
    new_posts = cursor.fetchone()
    conn.commit()
    print(new_posts)
    return {"message":new_posts}


@app.get("/posts/{id}")# creating indivudual post, Imported Resposne and Status in FAst APi interface
def get_id(id:int,response:Response):
    print(type(id))
    post=find_path(int(id))
    
    if not post: # response-> property of status code
       # response.status_code = 404 # this worked
        #  response.status_code = status.HTTP_404_NOT_FOUND
        #  return {"message": f" post with {id} is not found"}
        raise HTTPException(status_code= 404, detail=f"post with {id} is not found")
    print(post)
    return{"Post_detail":post}

@app.delete("/posts/{id}", status_code=status.HTTP_204_NO_CONTENT)# need to write the status code
def delete_post(id: int): #def find_index_post(id):
    #deleting post
    #find the index in the array that has required id
    #my_posts.pop(index)
    #call funtion
    index = find_index_post(id)
     
    if index == None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND,detail=f"post with id {id} does not exist")
    my_post.pop(index) 
   # return{"Delete": "post successfully deleted"}
    return Response(status_code=status.HTTP_204_NO_CONTENT)

@app.put("/posts/{id}")
def update_post(id: int,post:Post):
    print(post)
    index = find_index_post(id)
    if index == None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND,detail=f"post with id {id} does not exist")
    
    post_dict = post.model_dump() 
    post_dict[ 'id' ] = id
    my_post[index] = post_dict
    return {"data": post_dict}
