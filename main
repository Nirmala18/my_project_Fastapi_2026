from fastapi import FastAPI,Response,status,HTTPException
from fastapi.params import Body
from pydantic import BaseModel
from typing import Optional
from random import randrange
import psycopg2
from psycopg2.extras import RealDictCursor 
import time

app=FastAPI()

class Post(BaseModel):
    title: str
    content:str
    published: bool = True
    #rating:Optional[int]=None
    
while True:    
#https://www.psycopg.org/docs/
    try:
        conn = psycopg2.connect(host='localhost',database='fastapi',user='postgres',
        password='password',cursor_factory=RealDictCursor)
        cursor = conn.cursor()
        print("Database connection is succesfull")
        break
    except Exception as error:
        print(" Connecting to  Database failed")
        print("error was ", error)
        time.sleep(2)
 
my_post=[{"title":"title of post1","content":"content of post 1","id":1},{"title":"favrite food",
"content":"I like pizza","id":2}]

def find_path(id): # @app.get("/posts/{id}")
    for p in my_post:
        if p['id']==id:
            return p

# Delete the id -> @app.delete("posts/{id}")
# find the index in the array,try to get the index of that specific item., iterate over specific item
def find_index_post(id):
    for i ,p in enumerate(my_post):
        if p['id'] == id:
            return i 


@app.get("/postarray")
def root():
    return{"data": my_post}


@app.get("/post")#getting all posts
def root():
    return{"data": "welcome to world api"}

@app.get("/posts")
def get_posts():
    cursor.execute("""SELECT * FROM posts """)
    posts = cursor.fetchall()
    #print(posts)
    return {"data": posts}

@app.get("/")
def root():
    return {"message": "welcome to dev api"}

